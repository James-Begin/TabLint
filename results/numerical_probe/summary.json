    "torch_nanstd": {
      "file": ".venv/lib/python3.12/site-packages/tabpfn/preprocessing/torch/ops.py",
      "start": 38,
      "source": "38: def torch_nanstd(x: torch.Tensor, axis: int = 0) -> torch.Tensor:\n39:     \"\"\"Compute standard deviation of a tensor over a given dimension, ignoring NaNs.\n40: \n41:     Args:\n42:         x: The input tensor.\n43:         axis: The dimension to reduce.\n44: \n45:     Returns:\n46:         The standard deviation of the input tensor, ignoring NaNs.\n47:     \"\"\"\n48:     nan_mask = torch.isnan(x)\n49:     num_valid = torch.where(\n50:         nan_mask,\n51:         torch.zeros_like(x),\n52:         torch.ones_like(x),\n53:     ).sum(dim=axis)\n54:     value_sum = torch.where(nan_mask, torch.zeros_like(x), x).sum(dim=axis)\n55: \n56:     mean = value_sum / num_valid.clamp(min=1.0)\n57: \n58:     # Broadcast mean back to original shape for subtraction\n59:     mean_broadcast = mean.unsqueeze(axis).expand_as(x)\n60: \n61:     # Compute sum of squared differences, ignoring NaNs\n62:     sq_diff = torch.where(\n63:         nan_mask,\n64:         torch.zeros_like(x),\n65:         torch.square(x - mean_broadcast),\n66:     ).sum(dim=axis)\n67: \n68:     # Use correction (N-1) to match sklearn's behavior\n69:     variance = sq_diff / (num_valid - 1).clamp(min=1.0)\n70: \n71:     return torch.sqrt(variance)\n"
    },
    "fit": {
      "file": ".venv/lib/python3.12/site-packages/tabpfn/preprocessing/torch/torch_standard_scaler.py",
      "start": 19,
      "source": "19:     def fit(self, x: torch.Tensor) -> dict[str, torch.Tensor]:\n20:         \"\"\"Compute the mean and standard deviation over the first dimension.\n21: \n22:         Args:\n23:             x: Input tensor with shape [T, ...] where T is the number of rows.\n24: \n25:         Returns:\n26:             Cache dictionary with the cache for the transform step.\n27:         \"\"\"\n28:         mean = torch_nanmean(x, axis=0)\n29:         std = torch_nanstd(x, axis=0)\n30: \n31:         # Handle constant features (std=0) by setting std to 1\n32:         std = torch.where(std == 0, torch.ones_like(std), std)\n33: \n34:         if x.shape[0] == 1:\n35:             std = torch.ones_like(std)\n36: \n37:         return {\"mean\": mean, \"std\": std}\n"
    },
    "_ecdf_midrank_counts": {
      "file": ".venv/lib/python3.12/site-packages/tabpfn/architectures/tabpfn_v3_5.py",
      "start": 3251,
      "source": "3251: def _ecdf_midrank_counts(\n3252:     values_BCRi: torch.Tensor, ecdf_context: torch.Tensor\n3253: ) -> torch.Tensor:\n3254:     \"\"\"Midrank of each value against the buckets, as a train-row count.\n3255: \n3256:     A value outside the train range gets the midrank of the nearest train\n3257:     extreme, not 0 or the row count.\n3258:     \"\"\"\n3259:     edges_BCK, below_BCK, at_most_BCK = ecdf_context\n3260:     k = edges_BCK.shape[-1]\n3261:     # int32 indices halve these two transients; K is a bucket count.\n3262:     left = torch.searchsorted(edges_BCK, values_BCRi, side=\"left\", out_int32=True)\n3263:     right = torch.searchsorted(edges_BCK, values_BCRi, side=\"right\", out_int32=True)\n3264: \n3265:     lo_idx = (left - 1).clamp(min=0).to(torch.int64)\n3266:     hi_idx = left.clamp(max=k - 1).to(torch.int64)\n3267:     edge_lo = edges_BCK.gather(-1, lo_idx)\n3268:     edge_hi = edges_BCK.gather(-1, hi_idx)\n3269:     at_most_lo = at_most_BCK.gather(-1, lo_idx)\n3270:     below_hi = below_BCK.gather(-1, hi_idx)\n3271: \n3272:     # The two ends coincide only outside the edge range, where the clamp already\n3273:     # leaves the right count: n above the last edge, and 0 below the first once\n3274:     # the override below applies.\n3275:     width = edge_hi - edge_lo\n3276:     inside = width > 0\n3277:     # Divide by 1 outside a bucket instead of masking the quotient: `where`\n3278:     # backpropagates through the branch it discards, and 0 * inf is NaN. Prompt\n3279:     # tuning optimises the cells, so that NaN would reach them.\n3280:     weight = torch.where(\n3281:         inside, (values_BCRi - edge_lo) / torch.where(inside, width, 1.0), 0.0\n3282:     )\n3283:     counts = at_most_lo + weight * (below_hi - at_most_lo)\n3284:     is_edge = right > left\n3285:     exact = 0.5 * (below_hi + at_most_BCK.gather(-1, hi_idx))\n3286:     counts = torch.where(is_edge, exact, counts)\n3287:     counts = torch.where((left == 0) & ~is_edge, counts.new_zeros(()), counts)\n3288: \n3289:     # Hold values outside the train range at the midrank of the train extreme.\n3290:     # A tied extreme sits half its tie block below the count an out-of-range\n3291:     # value would otherwise get, so the rank gap across the boundary grows with\n3292:     # the tie count while the value gap stays one step, and the model reads the\n3293:     # difference as distance and over-extrapolates.\n3294:     mid_lo = 0.5 * (below_BCK[..., :1] + at_most_BCK[..., :1])\n3295:     mid_hi = 0.5 * (below_BCK[..., -1:] + at_most_BCK[..., -1:])\n3296:     return counts.clamp(min=mid_lo, max=mid_hi)\n"
    },
    "_build_ecdf_context": {
      "file": ".venv/lib/python3.12/site-packages/tabpfn/architectures/tabpfn_v3_5.py",
      "start": 3176,
      "source": "3176: def _build_ecdf_context(\n3177:     x_BRiC: torch.Tensor, num_train: int, num_buckets: int\n3178: ) -> torch.Tensor:\n3179:     \"\"\"Summarise the train rows per (batch, column) into ECDF bucket edges.\n3180: \n3181:     Returns `(3, B, C, K)` at `ECDF_CONTEXT_DTYPE`, holding for each of `K =\n3182:     min(num_buckets, num_train)` edges: the edge value, and the counts of train\n3183:     values strictly below it and at most equal to it. The counts are exact, so\n3184:     `_in_context_ecdf` reproduces the true midrank on any value that is an edge.\n3185: \n3186:     A column with at most `K` distinct values gets one edge per distinct value,\n3187:     which is what makes it exact: consecutive edges then leave no unseen value\n3188:     between them for interpolation to guess at. Above `K` the edges are spaced\n3189:     over row positions instead, so every edge carries the same share of the\n3190:     column and no dense value is skipped.\n3191:     \"\"\"\n3192:     rows_BNC = x_BRiC[:, :num_train] if num_train > 0 else x_BRiC\n3193:     columns = rows_BNC.shape[2]\n3194:     columns_per_pass = max(1, _ECDF_CELL_BUDGET // rows_BNC.shape[1])\n3195:     if columns_per_pass < columns:\n3196:         return torch.cat(\n3197:             [\n3198:                 _build_ecdf_context(\n3199:                     x_BRiC[:, :, start : start + columns_per_pass],\n3200:                     num_train,\n3201:                     num_buckets,\n3202:                 )\n3203:                 for start in range(0, columns, columns_per_pass)\n3204:             ],\n3205:             dim=2,\n3206:         )\n3207: \n3208:     sorted_BCN = (\n3209:         rows_BNC.transpose(1, 2).to(ECDF_CONTEXT_DTYPE).contiguous().sort(dim=-1).values\n3210:     )\n3211:     n = sorted_BCN.shape[-1]\n3212:     k = min(num_buckets, n)\n3213: \n3214:     # Index of each sorted position within the column's distinct values, so a\n3215:     # searchsorted over it maps a distinct index back to a row position.\n3216:     is_new = torch.ones_like(sorted_BCN, dtype=torch.int32)\n3217:     is_new[..., 1:] = (sorted_BCN[..., 1:] != sorted_BCN[..., :-1]).to(torch.int32)\n3218:     # In place: on a tall table this is as large as the sorted values themselves.\n3219:     distinct_idx_BCN = is_new.cumsum_(-1).sub_(1)\n3220:     num_distinct_BC1 = distinct_idx_BCN[..., -1:] + 1\n3221: \n3222:     steps = torch.arange(k, device=x_BRiC.device, dtype=ECDF_CONTEXT_DTYPE)\n3223:     if k > 1:\n3224:         # Two rulers, because they answer different questions. Evenly spaced\n3225:         # distinct indices hit every value a column has, but only while it has at\n3226:         # most `k` of them. Above that the rank error is paid in mass, not in\n3227:         # distinct values: a column whose rows pile onto a few values inside a\n3228:         # wide distinct range would starve exactly those values of edges, and\n3229:         # interpolating across them spans most of the column. Row positions are\n3230:         # mass-uniform by construction, so they take over there.\n3231:         distinct_BCK = steps * ((num_distinct_BC1 - 1).to(ECDF_CONTEXT_DTYPE) / (k - 1))\n3232:         rows_K = (steps * ((n - 1) / (k - 1))).round().to(torch.int64)\n3233:         targets_BCK = torch.where(\n3234:             num_distinct_BC1 <= k,\n3235:             distinct_BCK.round().to(torch.int32),\n3236:             distinct_idx_BCN.gather(-1, rows_K.expand(*sorted_BCN.shape[:2], k)),\n3237:         ).contiguous()\n3238:     else:\n3239:         targets_BCK = (\n3240:             steps.round().to(torch.int32).expand(*sorted_BCN.shape[:2], k).contiguous()\n3241:         )\n3242: \n3243:     below = torch.searchsorted(distinct_idx_BCN, targets_BCK, side=\"left\")\n3244:     at_most = torch.searchsorted(distinct_idx_BCN, targets_BCK, side=\"right\")\n3245:     edges_BCK = sorted_BCN.gather(-1, below)\n3246:     return torch.stack(\n3247:         [edges_BCK, below.to(ECDF_CONTEXT_DTYPE), at_most.to(ECDF_CONTEXT_DTYPE)]\n3248:     )\n"
    },
    "_in_context_ecdf": {
      "file": ".venv/lib/python3.12/site-packages/tabpfn/architectures/tabpfn_v3_5.py",
      "start": 3299,
      "source": "3299: def _in_context_ecdf(x_BRiC: torch.Tensor, ecdf_context: torch.Tensor) -> torch.Tensor:\n3300:     \"\"\"Midrank ECDF of each cell value against the train rows, via the buckets.\n3301: \n3302:     A value that is itself a bucket edge gets that edge's exact midrank, which\n3303:     handles ties. A value inside a bucket is interpolated linearly between the\n3304:     two counts the bucket's ends bracket \u2014 an interval that is empty when the\n3305:     buckets hold every distinct train value, so the estimate is then exact too.\n3306:     Inputs must be finite: torch sorts NaN last, so a NaN query would come out at\n3307:     the top train value's rank.\n3308:     \"\"\"\n3309:     num_rows, columns = x_BRiC.shape[1], x_BRiC.shape[2]\n3310:     at_most_BCK = ecdf_context[2]\n3311:     # The last edge is the column maximum, so its at-most count is the row count.\n3312:     n = at_most_BCK[..., -1:]\n3313: \n3314:     def rank(rows_BRjC: torch.Tensor) -> torch.Tensor:\n3315:         values_BCRj = rows_BRjC.transpose(1, 2).to(ECDF_CONTEXT_DTYPE).contiguous()\n3316:         counts_BCRj = _ecdf_midrank_counts(values_BCRj, ecdf_context)\n3317:         return (counts_BCRj / n).transpose(1, 2).to(x_BRiC.dtype)\n3318: \n3319:     if torch.compiler.is_compiling():\n3320:         # A Python loop over the row count would make Dynamo specialise on it,\n3321:         # which the dynamic-shape marking in `forward` forbids. The compiled path\n3322:         # ranks all rows in one pass; the inference row chunking bounds them.\n3323:         return rank(x_BRiC)\n3324: \n3325:     rows_per_pass = max(1, _ECDF_CELL_BUDGET // columns)\n3326:     ecdf_BRiC = torch.empty(x_BRiC.shape, dtype=x_BRiC.dtype, device=x_BRiC.device)\n3327:     for start in range(0, num_rows, rows_per_pass):\n3328:         rows = slice(start, start + rows_per_pass)\n3329:         ecdf_BRiC[:, rows] = rank(x_BRiC[:, rows])\n3330:     return ecdf_BRiC\n"
    }
  },
